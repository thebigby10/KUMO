// DO NOT RUN MIGRATIONS FROM THIS SERVICE!
// 
// This schema is a read-only copy of the main schema defined in:
//   /frontend/prisma/schema.prisma
// 
// The frontend owns all database migrations. This copy exists only for:
//   1. Prisma Client type generation for auth-service
//   2. Keeping type definitions in sync
// 
// To make schema changes:
//   1. Edit /frontend/prisma/schema.prisma
//   2. Run `npx prisma migrate dev` in /frontend
//   3. Copy the updated schema here
//   4. Run `npx prisma generate` in /backend/auth-service
// 
// This service only uses the User model for authentication operations.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// USER MODEL (Used by auth-service for login/signup/Google OAuth)
// =============================================================================
model User {
  id              String   @id @default(uuid())
  email           String   @unique
  name            String?
  password        String?  // Optional for Google Users
  avatar          String?
  googleId        String?
  isEmailVerified Boolean  @default(false)
  provider        String   @default("email")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations (required for Prisma schema validity, not used by auth-service)
  enrollments   Enrollment[]
  instructing   Instructor[]
  announcements Announcement[]
  submissions   Submission[]

  @@map("users")
}

// =============================================================================
// CLASSROOM MANAGEMENT
// =============================================================================
model Lab {
  id          String   @id @default(uuid())
  name        String
  section     String?
  subject     String?
  room        String?
  banner      String?
  description String?
  labCode     String   @unique
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments   Enrollment[]
  instructors   Instructor[]
  labWorks      LabWork[]
  announcements Announcement[]

  @@map("labs")
}

model Enrollment {
  id        String   @id @default(uuid())
  userEmail String
  labId     String
  joinedAt  DateTime @default(now())

  user User @relation(fields: [userEmail], references: [email])
  lab  Lab  @relation(fields: [labId], references: [id])

  @@unique([userEmail, labId])
  @@map("enrollments")
}

model Instructor {
  id        String @id @default(uuid())
  labId     String
  userEmail String
  role      Role   @default(ASSISTANT)

  lab  Lab  @relation(fields: [labId], references: [id])
  user User @relation(fields: [userEmail], references: [email])

  @@unique([labId, userEmail])
  @@map("instructors")
}

// =============================================================================
// COMMUNICATION (Stream/Announcements)
// =============================================================================
model Announcement {
  id        String   @id @default(uuid())
  labId     String
  content   String
  postedBy  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lab       Lab                    @relation(fields: [labId], references: [id])
  user      User                   @relation(fields: [postedBy], references: [email])
  materials AnnouncementMaterial[]

  @@map("announcements")
}

model AnnouncementMaterial {
  id             String  @id @default(uuid())
  title          String
  url            String
  description    String?
  announcementId String

  announcement Announcement @relation(fields: [announcementId], references: [id])

  @@map("announcement_materials")
}

// =============================================================================
// COURSEWORK (Lab Works & Tasks)
// =============================================================================
model LabWork {
  id          String    @id @default(uuid())
  labId       String
  title       String
  description String?
  totalPoints Int       @default(100)
  startTime   DateTime?
  endTime     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lab         Lab           @relation(fields: [labId], references: [id])
  tasks       LabTask[]
  materials   LabMaterial[]
  submissions Submission[]

  @@map("lab_works")
}

model LabTask {
  id          String   @id @default(uuid())
  labWorkId   String
  title       String
  description String?
  url         String?
  point       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  labWork           LabWork            @relation(fields: [labWorkId], references: [id])
  materials         TaskMaterial[]
  testCases         TestCase[]
  editors           Editor[]
  hints             Hint[]
  submissionRecords SubmissionRecord[]

  @@map("lab_tasks")
}

// =============================================================================
// SUPPORTING TABLES
// =============================================================================
model LabMaterial {
  id          String  @id @default(uuid())
  labWorkId   String
  title       String?
  description String?
  url         String

  labWork LabWork @relation(fields: [labWorkId], references: [id])

  @@map("lab_materials")
}

model TaskMaterial {
  id          String  @id @default(uuid())
  taskId      String
  title       String?
  description String?
  url         String?

  task LabTask @relation(fields: [taskId], references: [id])

  @@map("task_materials")
}

model TestCase {
  id           String @id @default(uuid())
  taskId       String
  input        String
  expectOutput String

  task LabTask @relation(fields: [taskId], references: [id])

  @@map("test_cases")
}

model Editor {
  id          String  @id @default(uuid())
  taskId      String
  solution    String
  description String?
  url         String?

  task LabTask @relation(fields: [taskId], references: [id])

  @@map("editors")
}

model Hint {
  id     String @id @default(uuid())
  taskId String
  hint   String

  task LabTask @relation(fields: [taskId], references: [id])

  @@map("hints")
}

// =============================================================================
// ENUMS
// =============================================================================
enum Role {
  OWNER
  ASSISTANT
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  RETURNED
}

// =============================================================================
// SUBMISSIONS (Student work submissions)
// =============================================================================
model Submission {
  id          String           @id @default(uuid())
  labWorkId   String
  userEmail   String
  status      SubmissionStatus @default(DRAFT)
  grade       Int?
  feedback    String?
  submittedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  labWork LabWork @relation(fields: [labWorkId], references: [id])
  user    User    @relation(fields: [userEmail], references: [email])
  records SubmissionRecord[]

  @@unique([labWorkId, userEmail])
  @@map("submissions")
}

model SubmissionRecord {
  id           String @id @default(uuid())
  submissionId String
  taskId       String
  code         String @db.Text
  language     String

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  task       LabTask    @relation(fields: [taskId], references: [id])

  @@unique([submissionId, taskId])
  @@map("submission_records")
}